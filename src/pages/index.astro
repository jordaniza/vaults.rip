---
import { getCollection, getEntry, render } from "astro:content";
import ProtocolIdentity from "../components/ProtocolIdentity.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const homepage = await getEntry("pages", "index");

if (!homepage) {
  throw new Error("Missing content/index.md");
}

const { Content } = await render(homepage);
const cases = (await getCollection("cases")).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
);
const protocols = [...new Set(cases.map((entry) => entry.data.protocol))].sort(
  (left, right) => left.localeCompare(right),
);
const components = [...new Set(cases.map((entry) => entry.data.component))].sort(
  (left, right) => left.localeCompare(right),
);
---

<BaseLayout>
  <section class="home-copy prose" aria-labelledby="about">
    <Content />
  </section>

  <section id="cases" aria-labelledby="cases-title">
    <h2 id="cases-title" class="case-heading">Cases</h2>
    <form class="case-filters" id="case-filters" role="search">
      <label>
        <span>Keywords</span>
        <input
          type="search"
          name="keywords"
          placeholder="Search cases"
          autocomplete="off"
          aria-controls="case-table"
        />
      </label>
      <label>
        <span>Protocol</span>
        <select name="protocol" aria-controls="case-table">
          <option value="">All protocols</option>
          {protocols.map((protocol) => <option value={protocol}>{protocol}</option>)}
        </select>
      </label>
      <label>
        <span>Component</span>
        <select name="component" aria-controls="case-table">
          <option value="">All components</option>
          {components.map((component) => <option value={component}>{component}</option>)}
        </select>
      </label>
    </form>
    <div class="table-wrap">
      <table id="case-table">
        <thead>
          <tr>
            <th scope="col" aria-sort="ascending">
              <button class="case-sort" type="button" data-sort-key="title">Case</button>
            </th>
            <th scope="col" aria-sort="none">
              <button class="case-sort" type="button" data-sort-key="protocol">
                Protocol
              </button>
            </th>
            <th scope="col" aria-sort="none">
              <button class="case-sort" type="button" data-sort-key="component">
                Component
              </button>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            cases.map((entry) => (
              <tr
                class="case-row"
                data-title={entry.data.title.toLocaleLowerCase()}
                data-protocol={entry.data.protocol.toLocaleLowerCase()}
                data-component={entry.data.component.toLocaleLowerCase()}
                data-search={`${entry.data.title} ${entry.data.protocol} ${entry.data.component}`.toLocaleLowerCase()}
              >
                <td><a href={`/cases/${entry.id}/`}>{entry.data.title}</a></td>
                <td class="protocol-cell">
                  <ProtocolIdentity protocol={entry.data.protocol} />
                </td>
                <td>{entry.data.component}</td>
              </tr>
            ))
          }
          <tr id="case-filter-empty" hidden>
            <td colspan="3">No cases match these filters.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    const legacyCase = new URLSearchParams(window.location.search).get("case");

    if (legacyCase && /^[a-z0-9-]+(?:\/[a-z0-9-]+)*$/.test(legacyCase)) {
      window.location.replace(`/cases/${legacyCase}/`);
    }

    const filters = document.querySelector("#case-filters");
    const caseTableBody = document.querySelector("#case-table tbody");
    const emptyState = document.querySelector("#case-filter-empty");
    const sortButtons = [...document.querySelectorAll(".case-sort")];

    if (filters instanceof HTMLFormElement && caseTableBody && emptyState) {
      const rows = [...caseTableBody.querySelectorAll(".case-row")];
      let sortKey = "title";
      let direction = 1;

      const updateCases = () => {
        const formData = new FormData(filters);
        const keywords = String(formData.get("keywords") ?? "").trim().toLocaleLowerCase();
        const protocol = String(formData.get("protocol") ?? "").toLocaleLowerCase();
        const component = String(formData.get("component") ?? "").toLocaleLowerCase();
        let visibleCases = 0;

        rows
          .sort((left, right) => {
            const primary = String(left.dataset[sortKey]).localeCompare(
              String(right.dataset[sortKey]),
            );
            const title = String(left.dataset.title).localeCompare(String(right.dataset.title));

            return direction * (primary || title);
          })
          .forEach((row) => {
            const matches =
              (!keywords || String(row.dataset.search).includes(keywords)) &&
              (!protocol || row.dataset.protocol === protocol) &&
              (!component || row.dataset.component === component);

            row.hidden = !matches;
            visibleCases += Number(matches);
            caseTableBody.append(row);
          });

        emptyState.hidden = visibleCases !== 0;
        caseTableBody.append(emptyState);
      };

      filters.addEventListener("input", updateCases);
      sortButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextSortKey = button.dataset.sortKey;

          if (!nextSortKey) return;

          if (nextSortKey === sortKey) {
            direction *= -1;
          } else {
            sortKey = nextSortKey;
            direction = 1;
          }

          sortButtons.forEach((sortButton) => {
            const header = sortButton.closest("th");
            const isActive = sortButton.dataset.sortKey === sortKey;

            header?.setAttribute(
              "aria-sort",
              isActive ? (direction === 1 ? "ascending" : "descending") : "none",
            );
          });

          updateCases();
        });
      });
      updateCases();
    }
  </script>
</BaseLayout>
