---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import ProtocolIdentity from "../../components/ProtocolIdentity.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases");

  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"cases">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const contents = headings.filter((heading) => heading.depth === 2);
const markdownPath = `/content/cases/${entry.id}.md`;
const markdownHref = import.meta.env.DEV
  ? `${markdownPath}?raw`
  : new URL(markdownPath, Astro.site).toString();
const summary = entry.body
  ?.match(/## Summary\s+([\s\S]*?)(?=\n## |$)/)?.[1]
  .trim()
  .replace(/\s+/g, " ");
const description =
  summary && !summary.startsWith("Lorem ipsum")
    ? summary
    : "A catalogue of experiments documenting how DeFi vault operators can misconfigure vaults, for due diligence, underwriting, and LLM-friendly workflows.";
---

<BaseLayout
  title={`${entry.data.title} — vaults.rip`}
  description={description}
  canonicalPath={`/cases/${entry.id}/`}
  markdownPath={`/content/cases/${entry.id}.md`}
>
  <article class="case-content prose" aria-labelledby="case-title">
    <h1 id="case-title">{entry.data.title}</h1>
    <a class="case-markdown-link" href={markdownHref}>
      <span class="case-markdown-label">View Markdown</span>
      <span class="case-markdown-arrow" aria-hidden="true">↗</span>
    </a>
    <dl class="case-metadata case-metadata--single" aria-label="Case metadata">
      <div>
        <dt>Protocol</dt>
        <dd>
          <ProtocolIdentity protocol={entry.data.protocol} size="detail" />
        </dd>
      </div>
    </dl>
    {
      contents.length > 0 && (
        <nav class="case-toc" aria-labelledby="case-toc-title">
          <h2 id="case-toc-title">Contents</h2>
          <ol>
            {contents.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      )
    }
    <Content />
    <nav class="case-return" aria-label="Article navigation">
      <a href="/">
        <span class="case-return-label">Home</span>
        <span class="case-return-arrow" aria-hidden="true">←</span>
      </a>
    </nav>
  </article>
</BaseLayout>
